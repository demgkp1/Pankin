<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pankin.Desktop.ViewModels"
        xmlns:loc="using:Pankin.Desktop.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="464" d:DesignHeight="624"
        x:Class="Pankin.Desktop.Views.ClipboardWindow"
        x:DataType="vm:ClipboardViewModel"
        Width="464" Height="624"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Topmost="True"
        TransparencyLevelHint="AcrylicBlur, Blur, Transparent"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Title="{loc:Loc Clipboard_Title}">

    <Window.Styles>
        <!-- 分类切换药丸按钮 -->
        <Style Selector="Button.cat-tab">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource Pk.Radius.Pill}" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.cat-tab.normal">
            <Setter Property="Background" Value="{DynamicResource Pk.SurfaceInput}" />
            <Setter Property="Foreground" Value="{DynamicResource Pk.TextSecondary}" />
        </Style>
        <Style Selector="Button.cat-tab.normal:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Pk.SurfaceHover}" />
            <Setter Property="Foreground" Value="{DynamicResource Pk.Text}" />
        </Style>
        <Style Selector="Button.cat-tab.active">
            <Setter Property="Background" Value="{DynamicResource Pk.AccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource Pk.AccentText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.cat-tab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Pk.AccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource Pk.AccentText}" />
        </Style>

        <!-- 历史记录行快捷操作按钮 -->
        <Style Selector="Button.clip-action-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource Pk.Radius.Control}" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.clip-action-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Pk.SurfaceHover}" />
        </Style>
        <Style Selector="Button.clip-action-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Pk.SurfacePressed}" />
        </Style>
    </Window.Styles>

    <!-- 主玻璃面板（留白 12px 用于呈现投影） -->
    <Border Classes="frosted-panel"
            Margin="12"
            CornerRadius="{Binding PanelCornerRadius}">
        <Panel>
            <!-- 顶部柔和高光 -->
            <Border Classes="sheen" CornerRadius="{Binding PanelCornerRadius}" />

            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                <!-- 顶部搜索胶囊与清空操作区 -->
                <Border Grid.Row="0"
                        Name="TopDragArea"
                        Background="Transparent"
                        Padding="16,14,16,8">
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- 搜索框胶囊 -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource Pk.SurfaceInput}"
                                BorderBrush="{DynamicResource Pk.Stroke}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Pk.Radius.Control}"
                                Padding="10,6">
                            <Grid ColumnDefinitions="Auto,*">
                                <Path Grid.Column="0"
                                      Data="M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z M21 21l-4.35-4.35"
                                      Width="14" Height="14"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource Pk.Accent}"
                                      StrokeThickness="1.9"
                                      StrokeJoin="Round"
                                      StrokeLineCap="Round"
                                      Fill="Transparent"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0" />

                                <TextBox Grid.Column="1"
                                         Name="SearchInput"
                                         Classes="pane-search"
                                         Text="{Binding SearchKeyword, Mode=TwoWay}"
                                         Watermark="{loc:Loc Clipboard_SearchPlaceholder}"
                                         FontSize="13" />
                            </Grid>
                        </Border>

                        <!-- 清空按钮 -->
                        <Button Grid.Column="1"
                                Command="{Binding ClearUnpinnedCommand}"
                                Background="{DynamicResource Pk.DangerSoft}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource Pk.Radius.Control}"
                                Padding="10,6"
                                Margin="8,0,0,0"
                                ToolTip.Tip="{loc:Loc Clipboard_ClearAll}">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <Path Data="M3 6h18 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6 M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2 M10 11v6 M14 11v6"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource Pk.Danger}"
                                      StrokeThickness="1.75"
                                      StrokeJoin="Round"
                                      StrokeLineCap="Round"
                                      Fill="Transparent"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc Common_Clear}"
                                           FontSize="11.5"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource Pk.Danger}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 胶囊分类栏 -->
                <Border Grid.Row="1"
                        Padding="16,2,16,10"
                        Background="Transparent">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClipboardCategoryTab">
                                <Button Content="{Binding Name}"
                                        Command="{Binding SelectCommand}"
                                        Classes="cat-tab"
                                        Classes.active="{Binding IsSelected}"
                                        Classes.normal="{Binding !IsSelected}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- 分割线 -->
                <Border Grid.Row="2" Classes="divider-h" />

                <!-- 历史记录列表 -->
                <ListBox Grid.Row="3"
                         Name="HistoryListBox"
                         Classes="pk-list"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Padding="10,6">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ClipboardItemViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,1">
                                <!-- 左侧 34x34 类型图标底座 -->
                                <Border Grid.Column="0"
                                        Classes="icon-badge"
                                        Width="34" Height="34"
                                        Background="{Binding TagColor}"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding KindName}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- 正文最多 2 行 + 底部元信息 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding PreviewText}"
                                               Classes="body"
                                               MaxLines="2"
                                               LineHeight="18"
                                               TextWrapping="Wrap" />

                                    <TextBlock Text="{Binding SubtitleInfo}"
                                               Classes="caption" />
                                </StackPanel>

                                <!-- 右侧快捷操作按钮组 -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Spacing="2"
                                            Margin="8,0,0,0">
                                    <!-- Alt 1~9 快捷键提示 -->
                                    <Border Classes="keycap"
                                            Margin="0,0,4,0"
                                            IsVisible="{Binding HotkeyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Classes="keycap-text" Text="{Binding HotkeyText}" />
                                    </Border>

                                    <!-- 固定按钮 (矢量 Pin) -->
                                    <Button Classes="clip-action-btn"
                                            Command="{Binding TogglePinCommand}"
                                            ToolTip.Tip="固定/取消固定">
                                        <Path Data="M12 17v5 M9 2h6 M9 10a5 5 0 0 0-2 4v3h10v-3a5 5 0 0 0-2-4V4h-6v6z"
                                              Width="13" Height="13"
                                              Stretch="Uniform"
                                              Stroke="{Binding PinStrokeColor}"
                                              StrokeThickness="1.75"
                                              StrokeJoin="Round"
                                              StrokeLineCap="Round"
                                              Fill="Transparent" />
                                    </Button>

                                    <!-- 删除按钮 (矢量 X) -->
                                    <Button Classes="clip-action-btn"
                                            Command="{Binding DeleteCommand}"
                                            ToolTip.Tip="删除记录">
                                        <Path Data="M18 6L6 18 M6 6l12 12"
                                              Width="12" Height="12"
                                              Stretch="Uniform"
                                              Stroke="{DynamicResource Pk.TextTertiary}"
                                              StrokeThickness="1.75"
                                              StrokeJoin="Round"
                                              StrokeLineCap="Round"
                                              Fill="Transparent" />
                                    </Button>

                                    <!-- 粘贴按钮 (矢量箭头) -->
                                    <Button Classes="clip-action-btn"
                                            Command="{Binding PasteCommand}"
                                            ToolTip.Tip="粘贴上屏">
                                        <Path Data="M5 12h14 M12 5l7 7-7 7"
                                              Width="12" Height="12"
                                              Stretch="Uniform"
                                              Stroke="{DynamicResource Pk.Accent}"
                                              StrokeThickness="1.75"
                                              StrokeJoin="Round"
                                              StrokeLineCap="Round"
                                              Fill="Transparent" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 底部双行快捷键提示栏 -->
                <Border Grid.Row="4"
                        Background="{DynamicResource Pk.SurfaceFooter}"
                        BorderBrush="{DynamicResource Pk.Divider}"
                        BorderThickness="0,1,0,0"
                        Padding="16,8">
                    <StackPanel Spacing="6">
                        <!-- 第一行：粘贴动作 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Border Classes="keycap"><TextBlock Classes="keycap-text" Text="Alt" /></Border>
                                <TextBlock Classes="hint" Text="+" Margin="1,0" />
                                <Border Classes="keycap"><TextBlock Classes="keycap-text" Text="1~9" /></Border>
                                <TextBlock Classes="hint" Text="快速粘贴" Margin="4,0,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Border Classes="keycap"><TextBlock Classes="keycap-text" Text="↵" /></Border>
                                <TextBlock Classes="hint" Text="粘贴选中" />
                            </StackPanel>
                        </Grid>

                        <!-- 第二行：辅助操作 -->
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Border Classes="keycap"><TextBlock Classes="keycap-text" Text="Del" /></Border>
                                <TextBlock Classes="hint" Text="删除" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" VerticalAlignment="Center">
                                <Border Classes="keycap"><TextBlock Classes="keycap-text" Text="Ctrl" /></Border>
                                <TextBlock Classes="hint" Text="+" Margin="1,0" />
                                <Border Classes="keycap"><TextBlock Classes="keycap-text" Text="F" /></Border>
                                <TextBlock Classes="hint" Text="搜索" Margin="4,0,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Border Classes="keycap"><TextBlock Classes="keycap-text" Text="Esc" /></Border>
                                <TextBlock Classes="hint" Text="隐藏" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Panel>
    </Border>
</Window>