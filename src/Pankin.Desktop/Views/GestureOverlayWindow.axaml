<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Pankin.Desktop.Views.GestureOverlayWindow"
        Width="324" Height="134"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="Manual"
        CanResize="False"
        IsHitTestVisible="False"
        Title="Pankin 手势提示">

    <!-- 磨砂玻璃手势提示胶囊 (留白 12px 用于呈现投影，完全鼠标穿透) -->
    <Border Name="OverlayCard"
            Classes="frosted-panel"
            Margin="12"
            CornerRadius="16"
            Padding="14,10">
        <Panel>
            <!-- 顶部柔和高光 -->
            <Border Classes="sheen" CornerRadius="16" />

            <Grid RowDefinitions="Auto,*,Auto">
                <!-- 顶部：手势方向箭头、动作名称与代码 -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                    <!-- 方向箭头圆形徽章 -->
                    <Border Grid.Column="0"
                            Width="32" Height="32"
                            Background="{DynamicResource Pk.AccentSoft}"
                            CornerRadius="16"
                            Margin="0,0,10,0">
                        <TextBlock Name="ArrowText"
                                   Text="→"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Pk.Accent}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- 绑定的快捷动作文案 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Name="ActionLabel"
                                   Text="前进 (Alt+Right)"
                                   Classes="body"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Name="HintLabel"
                                   Text="松开执行手势"
                                   Classes="caption"
                                   Margin="0,1,0,0" />
                    </StackPanel>

                    <!-- 轨迹代码徽章 (如 R, DR, Hold) -->
                    <Border Grid.Column="2"
                            Classes="keycap"
                            VerticalAlignment="Center">
                        <TextBlock Name="CodeLabel"
                                   Classes="keycap-text"
                                   Text="R" />
                    </Border>
                </Grid>

                <!-- 中间：实时鼠标轨迹简图 -->
                <Canvas Grid.Row="1"
                        Name="TrailCanvas"
                        Height="34"
                        Margin="0,6,0,0"
                        ClipToBounds="True">
                    <Polyline Name="TrailPolyline"
                              Stroke="{DynamicResource Pk.Accent}"
                              StrokeThickness="2.5"
                              StrokeLineCap="Round"
                              StrokeJoin="Round" />
                </Canvas>
            </Grid>
        </Panel>
    </Border>
</Window>