<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pankin.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="944" d:DesignHeight="604"
        x:Class="Pankin.Desktop.Views.RenameWindow"
        x:DataType="vm:RenameViewModel"
        Width="944" Height="604"
        MinWidth="784" MinHeight="464"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="AcrylicBlur, Blur, Transparent"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        Title="批量重命名 (Batch Rename)">

    <!-- 主玻璃面板（留白 12px 用于呈现投影） -->
    <Border Classes="frosted-panel"
            Margin="12"
            CornerRadius="{StaticResource Pk.Radius.Window}">
        <Panel>
            <!-- 顶部柔和高光 -->
            <Border Classes="sheen" CornerRadius="{StaticResource Pk.Radius.Window}" />

            <Grid RowDefinitions="52,Auto,*,52">
                <!-- 顶部拖拽栏 -->
                <Border Grid.Row="0"
                        Background="Transparent"
                        x:Name="TopDragArea"
                        Padding="18,0,12,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="22" Height="22" CornerRadius="6" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Offset="0" Color="#9B8CFF" />
                                        <GradientStop Offset="1" Color="#5B6CFF" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="P" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="批量重命名 (Batch Rename)" Classes="h2" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Classes="icon-btn"
                                Width="30" Height="30"
                                VerticalAlignment="Center"
                                ToolTip.Tip="关闭"
                                Click="OnCloseClick">
                            <Path Data="M18 6L6 18 M6 6l12 12"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  StrokeThickness="1.75"
                                  StrokeJoin="Round"
                                  StrokeLineCap="Round" />
                        </Button>
                    </Grid>
                </Border>

                <!-- 分割线 -->
                <Border Grid.Row="1" Classes="divider-h" />

                <!-- 主体区域：左侧规则，右侧预览 -->
                <Grid Grid.Row="2" ColumnDefinitions="330,*" Margin="16,14">
                    <!-- 左侧规则栏 -->
                    <Border Grid.Column="0"
                            Classes="module-card"
                            Margin="0,0,12,0"
                            Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10">
                                <TextBlock Text="重命名规则" Classes="h2" Foreground="{DynamicResource Pk.AccentText}" />

                                <TextBlock Text="规则种类:" Classes="caption" Margin="0,4,0,0"/>
                                <ComboBox SelectedIndex="{Binding SelectedRuleTypeIndex}" HorizontalAlignment="Stretch" FontSize="12">
                                    <ComboBoxItem Content="替换文本 (Replace)"/>
                                    <ComboBoxItem Content="插入文本 (Insert)"/>
                                    <ComboBoxItem Content="数字编号 (Number)"/>
                                    <ComboBoxItem Content="修改大小写 (Case)"/>
                                    <ComboBoxItem Content="修改扩展名 (Extension)"/>
                                </ComboBox>

                                <TextBlock Text="查找文本:" Classes="caption" Margin="0,4,0,0"/>
                                <TextBox Classes="pk-input" Text="{Binding FindText}" Watermark="留空或输入查找内容" FontSize="12"/>

                                <TextBlock Text="替换 / 插入文本:" Classes="caption" Margin="0,4,0,0"/>
                                <TextBox Classes="pk-input" Text="{Binding ReplaceText}" Watermark="目标文本 / 扩展名" FontSize="12"/>

                                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                    <CheckBox IsChecked="{Binding IsRegex}" Content="正则表达式" FontSize="12"/>
                                    <CheckBox IsChecked="{Binding MatchCase}" Content="区分大小写" FontSize="12"/>
                                </StackPanel>

                                <Button Classes="accent" Content="添加规则" Command="{Binding AddRuleCommand}" HorizontalAlignment="Stretch" Margin="0,6,0,0"/>

                                <Border Classes="divider-h" Margin="0,8"/>

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="已启用的规则列表" Classes="section" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Classes="secondary-btn" Content="清空" Command="{Binding ClearRulesCommand}" Padding="8,4" FontSize="11"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Rules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Pk.SurfaceInput}"
                                                    BorderBrush="{DynamicResource Pk.Stroke}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource Pk.Radius.Control}"
                                                    Padding="8,6"
                                                    Margin="0,3">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding DisplayText}" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="1"
                                                            Classes="icon-btn"
                                                            Width="22" Height="22"
                                                            Command="{Binding $parent[Window].DataContext.RemoveRuleCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="删除规则">
                                                        <Path Data="M18 6L6 18 M6 6l12 12"
                                                              Width="10" Height="10"
                                                              Stretch="Uniform"
                                                              Stroke="{DynamicResource Pk.Danger}"
                                                              StrokeThickness="1.75"
                                                              StrokeJoin="Round"
                                                              StrokeLineCap="Round" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- 右侧预览列表 -->
                    <Border Grid.Column="1"
                            Classes="module-card"
                            Margin="0"
                            Padding="16">
                        <Grid RowDefinitions="Auto,*">
                            <Grid Grid.Row="0" ColumnDefinitions="*,30,*,100" Margin="8,0,8,8">
                                <TextBlock Text="原文件名" Classes="section"/>
                                <TextBlock Grid.Column="2" Text="新文件名" Classes="section"/>
                                <TextBlock Grid.Column="3" Text="状态" Classes="section" HorizontalAlignment="Right"/>
                            </Grid>

                            <ListBox Grid.Row="1" ItemsSource="{Binding Previews}" Classes="pk-list">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,30,*,100" Margin="0,2">
                                            <TextBlock Text="{Binding OldName}" Classes="body" Foreground="{DynamicResource Pk.TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="→" Foreground="{DynamicResource Pk.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding NewName}" Classes="body" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="3" Background="{Binding BadgeColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding IssueBadge}" FontSize="11" Foreground="#FFFFFF"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 底部状态栏与操作按钮 -->
                <Border Grid.Row="3"
                        Background="{DynamicResource Pk.SurfaceFooter}"
                        BorderBrush="{DynamicResource Pk.Divider}"
                        BorderThickness="0,1,0,0"
                        Padding="18,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Classes="caption" TextTrimming="CharacterEllipsis"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="secondary-btn" Content="添加文件..." Click="OnAddFilesClick"/>
                            <Button Classes="secondary-btn" Content="刷新预览" Command="{Binding RefreshPreviewCommand}"/>
                            <Button Classes="secondary-btn" Content="撤销刚才 (Ctrl+Z)" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"/>
                            <Button Classes="accent" Content="执行重命名 (Ctrl+Enter)" Command="{Binding ApplyRenameCommand}" IsEnabled="{Binding CanApply}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Panel>
    </Border>
</Window>