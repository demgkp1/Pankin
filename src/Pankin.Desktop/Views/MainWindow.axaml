<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pankin.Desktop.ViewModels"
        xmlns:loc="using:Pankin.Desktop.Localization"
        x:Class="Pankin.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="640" Height="496" UseLayoutRounding="True"
        ShowInTaskbar="False" SystemDecorations="None" Topmost="True"
        TransparencyLevelHint="AcrylicBlur, Blur, Transparent"
        Background="Transparent" ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterScreen" CanResize="False"
        Title="{loc:Loc Launcher_Title}">

    <Window.Resources>
        <ControlTheme x:Key="LauncherResultTheme" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Template">
                <ControlTemplate><ContentPresenter Name="PART_ContentPresenter" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" /></ControlTemplate>
            </Setter>
        </ControlTheme>
        <DataTemplate x:Key="AppTileTemplate" x:DataType="vm:AppTileItem">
            <Button Classes="app-tile" Command="{Binding LaunchCommand}"
                    ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="打开" Command="{Binding ExecuteCommand}" />
                        <MenuItem Header="{Binding PinMenuHeader}" Command="{Binding TogglePinCommand}" />
                        <MenuItem Header="打开文件所在位置" Command="{Binding OpenLocationCommand}" IsVisible="{Binding CanOpenLocation}" />
                        <MenuItem Header="以管理员身份运行" Command="{Binding RunAsAdminCommand}" IsVisible="{Binding CanRunAsAdmin}" />
                    </ContextMenu>
                </Button.ContextMenu>
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <Panel Classes="app-icon" HorizontalAlignment="Center">
                        <Image Source="{Binding IconBitmap}"
                               IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <Border Classes="icon-case" IsVisible="{Binding ShowIconPath}">
                            <Path Data="{Binding IconGeometry}" />
                        </Border>
                        <!-- An unbranded, neutral fallback, never a fabricated app logo. -->
                        <Border Classes="icon-case" IsVisible="{Binding ShowGlyph}">
                            <Path Data="M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z" />
                        </Border>
                    </Panel>
                    <TextBlock Text="{Binding Name}" Width="76" Height="32" FontSize="11.5"
                               Foreground="{DynamicResource Pk.Text}" TextAlignment="Center"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBox.pane-search /template/ TextBlock#PART_Watermark, TextBox.pane-search:focus /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="{DynamicResource Pk.LauncherMuted}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Regular" />
            <Setter Property="Foreground" Value="{DynamicResource Pk.LauncherMuted}" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource Pk.LauncherMuted}" />
        </Style>
        <Style Selector="Border.keycap">
            <Setter Property="Background" Value="{DynamicResource Pk.LauncherKey}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="4,1" />
        </Style>
        <Style Selector="TextBlock.keycap-text">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Pk.LauncherMuted}" />
        </Style>
        <Style Selector="Button.app-tile, Button.quick-action">
            <Setter Property="Width" Value="82" />
            <Setter Property="Height" Value="86" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.app-tile /template/ ContentPresenter#PART_ContentPresenter, Button.quick-action /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions><BrushTransition Property="Background" Duration="0:0:0.09" /></Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.app-tile:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.quick-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Pk.SurfaceHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Pk.Stroke}" />
        </Style>
        <Style Selector="Button.app-tile:focus-visible /template/ ContentPresenter#PART_ContentPresenter, Button.quick-action:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Pk.AccentSofter}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Pk.Accent}" />
        </Style>
        <Style Selector="Button.app-tile:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.quick-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Pk.SurfacePressed}" />
        </Style>
        <Style Selector="Panel.app-icon"><Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" /></Style>
        <Style Selector="Border.icon-case">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{DynamicResource Pk.SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Pk.Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.icon-case Path">
            <Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{DynamicResource Pk.TextSecondary}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeJoin" Value="Round" /><Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ItemsControl#PinnedItems Button.app-tile"><Setter Property="Height" Value="74" /></Style>
        <Style Selector="ItemsControl#PinnedItems Panel.app-icon"><Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" /></Style>
        <Style Selector="ItemsControl#PinnedItems Border.icon-case Path"><Setter Property="Width" Value="16" /><Setter Property="Height" Value="16" /></Style>
        <Style Selector="Button.quick-action"><Setter Property="Height" Value="64" /></Style>
        <!-- Group headings deliberately live outside result-row, not inside selection paint. -->

        <Style Selector="Border.result-row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.09" /></Transitions></Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover Border.result-row"><Setter Property="Background" Value="{DynamicResource Pk.SurfaceHover}" /></Style>
        <Style Selector="ListBoxItem:selected Border.result-row">
            <Setter Property="Background" Value="{DynamicResource Pk.AccentSofter}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Pk.AccentSoft}" />
        </Style>
        <Style Selector="ListBoxItem:focus-visible Border.result-row"><Setter Property="BorderBrush" Value="{DynamicResource Pk.Accent}" /></Style>
        <Style Selector="ListBoxItem:pressed Border.result-row"><Setter Property="Background" Value="{DynamicResource Pk.SurfacePressed}" /></Style>
        <Style Selector="Border.sel-bar, Path.enter-hint"><Setter Property="Opacity" Value="0" /></Style>
        <Style Selector="ListBoxItem:selected Border.sel-bar, ListBoxItem:selected Path.enter-hint"><Setter Property="Opacity" Value="1" /></Style>
    </Window.Styles>

    <!-- Shadow fits inside the transparent client margin, including at 200% scale. -->
    <Border Margin="18" CornerRadius="{Binding PanelCornerRadius}" BoxShadow="0 5 14 -3 #50000000">
        <Border Name="LauncherPanel" CornerRadius="{Binding PanelCornerRadius}" ClipToBounds="True"
                BorderBrush="{DynamicResource Pk.LauncherStroke}" BorderThickness="1">
            <Panel>
                <!-- No compositor blur: this underlay prevents background text bleeding through.
                     This is a readability fallback, NOT a blur simulation. -->
                <Border Name="ReadabilityShield" Background="{DynamicResource Pk.LauncherShield}" CornerRadius="{Binding PanelCornerRadius}" />
                <Border Background="{DynamicResource Pk.LauncherSurface}" CornerRadius="{Binding PanelCornerRadius}" />
                <Border Classes="sheen" CornerRadius="{Binding PanelCornerRadius}" />
                <Grid RowDefinitions="60,1,*,34">
                    <Border Name="TopDragArea" Padding="20,0,14,0" Background="Transparent">
                        <Grid ColumnDefinitions="20,*,32">
                            <Path Data="M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z M21 21l-4.35-4.35"
                                  Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource Pk.TextSecondary}"
                                  StrokeThickness="1.6" StrokeLineCap="Round" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Name="SearchInput" Classes="pane-search" Margin="12,0,8,0"
                                     Text="{Binding SearchQuery, Mode=TwoWay}" Watermark="{loc:Loc Launcher_SearchPlaceholder}"
                                     FontSize="18" VerticalAlignment="Center" AutomationProperties.Name="搜索应用、文件或操作" />
                            <Button Grid.Column="2" Classes="icon-btn" Command="{Binding OpenSettingsCommand}"
                                    ToolTip.Tip="设置 · Alt+," AutomationProperties.Name="设置" VerticalAlignment="Center">
                                <Path Data="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"
                                      Width="17" Height="17" Stretch="Uniform" StrokeThickness="1.6" StrokeLineCap="Round" />
                            </Button>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Classes="divider-h" />
                    <Grid Grid.Row="2">
                        <ScrollViewer IsVisible="{Binding IsSearchEmpty}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,12,14,8">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="section" Text="{loc:Loc Launcher_RecentApps}" Margin="6,0" />
                                    <ItemsControl Name="RecentItems" ItemsSource="{Binding RecentApps}" ItemTemplate="{StaticResource AppTileTemplate}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock IsVisible="{Binding !RecentApps.Count}" Text="搜索并打开应用后，会在这里显示" FontSize="12" Foreground="{DynamicResource Pk.LauncherMuted}" Margin="6,16" />
                                </StackPanel>
                                <StackPanel Spacing="3" IsVisible="{Binding PinnedTools.Count}">
                                    <TextBlock Classes="section" Text="{loc:Loc Launcher_PinnedApps}" Margin="6,0" />
                                    <ItemsControl Name="PinnedItems" ItemsSource="{Binding PinnedTools}" ItemTemplate="{StaticResource AppTileTemplate}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <Grid IsVisible="{Binding !IsSearchEmpty}" RowDefinitions="Auto,*">
                            <StackPanel Margin="14,10,14,5" Spacing="4">
                                <TextBlock Classes="section" Text="{Binding QuickActionTitle}" Margin="6,0" TextTrimming="CharacterEllipsis" />
                                <ItemsControl ItemsSource="{Binding QuickActions}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:QuickActionTile">
                                            <Button Classes="quick-action" Command="{Binding ExecuteCommand}">
                                                <StackPanel Spacing="5">
                                                    <Border Classes="icon-case" Width="32" Height="32" HorizontalAlignment="Center"><Path Data="{Binding IconGeometry}" /></Border>
                                                    <TextBlock Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource Pk.TextSecondary}" TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <ListBox Grid.Row="1" Name="ResultListBox" ItemContainerTheme="{StaticResource LauncherResultTheme}" Background="Transparent" BorderThickness="0" Padding="8,0,8,8"
                                     ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                     SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LauncherListItem">
                                        <StackPanel>
                                            <TextBlock IsVisible="{Binding IsFirstInGroup}" Classes="section" Text="{Binding GroupDisplayName}" Margin="12,8,0,4" />
                                            <Border Classes="result-row" Height="50">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="打开 / 执行" Command="{Binding ExecuteCommand}" />
                                                        <MenuItem Header="{Binding PinMenuHeader}" Command="{Binding TogglePinCommand}" IsVisible="{Binding CanPin}" />
                                                        <MenuItem Header="打开所在目录 (Ctrl+Enter)" Command="{Binding OpenLocationCommand}" IsVisible="{Binding CanOpenLocation}" />
                                                        <MenuItem Header="复制路径 / 内容" Command="{Binding CopyPathCommand}" />
                                                        <MenuItem Header="在终端中打开" Command="{Binding OpenInTerminalCommand}" IsVisible="{Binding CanOpenInTerminal}" />
                                                        <MenuItem Header="以管理员权限运行" Command="{Binding RunAsAdminCommand}" IsVisible="{Binding CanRunAsAdmin}" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid ColumnDefinitions="3,46,*,Auto,42,22" Margin="4,0,8,0">
                                                    <Border Classes="sel-bar" Width="2" Height="18" CornerRadius="1" Background="{DynamicResource Pk.Accent}" />
                                                    <Panel Grid.Column="1" Width="28" Height="28" VerticalAlignment="Center">
                                                        <Image Source="{Binding IconBitmap}" IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                        <Border Classes="icon-case" IsVisible="{Binding ShowIconPath}"><Path Data="{Binding IconGeometry}" Width="15" Height="15" /></Border>
                                                        <Border Classes="icon-case" IsVisible="{Binding ShowGlyph}"><Path Data="M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z" Width="15" Height="15" /></Border>
                                                    </Panel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource Pk.Text}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="{DynamicResource Pk.LauncherMuted}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Subtitle}" IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Text="{Binding Tag}" FontSize="10" Foreground="{DynamicResource Pk.LauncherMuted}" VerticalAlignment="Center" Margin="4,0,8,0" />
                                                    <TextBlock Grid.Column="4" Text="{Binding HotkeyText}" FontSize="10" Foreground="{DynamicResource Pk.LauncherMuted}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    <Path Grid.Column="5" Classes="enter-hint" Data="M9 10l-5 5 5 5 M20 4v7a4 4 0 0 1-4 4H4" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource Pk.AccentText}" StrokeThickness="1.6" StrokeLineCap="Round" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                    <Border Grid.Row="3" BorderBrush="{DynamicResource Pk.Divider}" BorderThickness="0,1,0,0" Padding="18,0" Background="{DynamicResource Pk.SurfaceFooter}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <TextBlock Text="Pankin" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Pk.TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Classes="hint" Text="{Binding HotkeyDisplay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="3"><Border Classes="keycap"><TextBlock Classes="keycap-text" Text="↑ ↓" /></Border><TextBlock Classes="hint" Text="选择" /></StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="3"><Border Classes="keycap"><TextBlock Classes="keycap-text" Text="↵" /></Border><TextBlock Classes="hint" Text="打开" /></StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="3"><Border Classes="keycap"><TextBlock Classes="keycap-text" Text="Ctrl P" /></Border><TextBlock Classes="hint" Text="固定" /></StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="3"><Border Classes="keycap"><TextBlock Classes="keycap-text" Text="Esc" /></Border><TextBlock Classes="hint" Text="隐藏" /></StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Panel>
        </Border>
    </Border>
</Window>
