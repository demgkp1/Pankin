<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pankin.Desktop.ViewModels"
        xmlns:loc="using:Pankin.Desktop.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="600"
        x:Class="Pankin.Desktop.Views.ClipboardWindow"
        x:DataType="vm:ClipboardViewModel"
        Width="440" Height="600"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Topmost="True"
        TransparencyLevelHint="AcrylicBlur, Blur, Transparent"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Title="{loc:Loc Clipboard_Title}">

    <Window.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="4,2" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#253B82F6" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#15FFFFFF" />
        </Style>
        <Style Selector="Button.clip-action-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#80FFFFFF" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.clip-action-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#25FFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
    </Window.Styles>

    <!-- 复合磨砂玻璃底层（98.5% 不透明炭灰基底，彻底遮挡底层窗口文字） -->
    <Border CornerRadius="{Binding PanelCornerRadius}"
            Background="#FC1B1C22"
            BorderBrush="#32FFFFFF"
            BorderThickness="1"
            BoxShadow="0 16 40 0 #66000000"
            ClipToBounds="True">
        <Panel>
            <!-- 叠加模拟原版 Pane-Win 磨砂漫反射柔和多点微光 -->
            <Border CornerRadius="{Binding PanelCornerRadius}" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0.0" Color="#1E3B5998" />
                        <GradientStop Offset="0.5" Color="#08FFFFFF" />
                        <GradientStop Offset="1.0" Color="#241E293B" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <!-- 顶部搜索胶囊区 (复刻 clipboard-dark.png) -->
                <Border Grid.Row="0"
                        Name="TopDragArea"
                        Background="Transparent"
                        Padding="14,12,14,6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Border Grid.Column="0"
                                Background="#14FFFFFF"
                                BorderBrush="#18FFFFFF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,6">
                            <Grid ColumnDefinitions="Auto,*">
                                <!-- 矢量搜索图标 -->
                                <Path Grid.Column="0"
                                      Data="M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z M21 21l-4.35-4.35"
                                      Width="13" Height="13"
                                      Stretch="Uniform"
                                      Stroke="#80FFFFFF"
                                      StrokeThickness="1.75"
                                      StrokeJoin="Round"
                                      StrokeLineCap="Round"
                                      Fill="Transparent"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0" />

                                <TextBox Grid.Column="1"
                                         Name="SearchInput"
                                         Classes="pane-search"
                                         Text="{Binding SearchKeyword, Mode=TwoWay}"
                                         Watermark="{loc:Loc Clipboard_SearchPlaceholder}"
                                         FontSize="13"
                                         Foreground="#F0FFFFFF"
                                         CaretBrush="#3B82F6" />
                            </Grid>
                        </Border>

                        <Button Grid.Column="1"
                                Command="{Binding ClearUnpinnedCommand}"
                                Background="#18EF4444"
                                BorderThickness="0"
                                CornerRadius="8"
                                Padding="8,5"
                                FontSize="11"
                                Margin="8,0,0,0"
                                ToolTip.Tip="{loc:Loc Clipboard_ClearAll}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Path Data="M3 6h18 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6 M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2 M10 11v6 M14 11v6"
                                      Width="11" Height="11"
                                      Stretch="Uniform"
                                      Stroke="#F87171"
                                      StrokeThickness="1.75"
                                      StrokeJoin="Round"
                                      StrokeLineCap="Round"
                                      Fill="Transparent"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc Common_Clear}" FontSize="11" Foreground="#F87171" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 胶囊分类栏 (每个 Tab 自带 SelectCommand，100% 杜绝 $parent 跨层级绑定) -->
                <Border Grid.Row="1"
                        Padding="14,4,14,8"
                        Background="Transparent">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClipboardCategoryTab">
                                <Button Content="{Binding Name}"
                                        Command="{Binding SelectCommand}"
                                        Margin="0,0,6,0"
                                        Padding="10,4"
                                        FontSize="11"
                                        CornerRadius="12"
                                        Classes.active="{Binding IsSelected}"
                                        Classes.normal="{Binding !IsSelected}"
                                        BorderThickness="0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.Styles>
                            <Style Selector="Button.active">
                                <Setter Property="Background" Value="#353B82F6" />
                                <Setter Property="Foreground" Value="#93C5FD" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                            <Style Selector="Button.normal">
                                <Setter Property="Background" Value="#12FFFFFF" />
                                <Setter Property="Foreground" Value="#A0FFFFFF" />
                            </Style>
                        </ItemsControl.Styles>
                    </ItemsControl>
                </Border>

                <!-- 历史记录列表 (排版复刻 clipboard-dark.png) -->
                <ListBox Grid.Row="2"
                         Name="HistoryListBox"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Margin="6,0,6,4">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ClipboardItemViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="2">
                                <!-- 左侧 34x34 类型图标框 -->
                                <Border Grid.Column="0"
                                        Width="34" Height="34"
                                        Background="{Binding TagColor}"
                                        CornerRadius="8"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding KindName}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- 正文最多 2 行 + 底部已固定/时间信息 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PreviewText}"
                                               FontSize="12"
                                               Foreground="#F0FFFFFF"
                                               MaxLines="2"
                                               LineHeight="17"
                                               TextWrapping="Wrap" />

                                    <TextBlock Text="{Binding SubtitleInfo}"
                                               FontSize="10"
                                               Foreground="#70FFFFFF"
                                               Margin="0,3,0,0" />
                                </StackPanel>

                                <!-- 右侧快捷操作按钮组 (自包含 Command，不走 $parent，全矢量图标) -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Spacing="2"
                                            Margin="6,0,0,0">
                                    <!-- Alt 1~9 快捷键提示 -->
                                    <Border IsVisible="{Binding HotkeyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            Background="#18FFFFFF"
                                            CornerRadius="4"
                                            Padding="5,2"
                                            VerticalAlignment="Center"
                                            Margin="0,0,4,0">
                                        <TextBlock Text="{Binding HotkeyText}" FontSize="10" Foreground="#93C5FD" />
                                    </Border>

                                    <!-- 固定按钮 (矢量 Pin) -->
                                    <Button Classes="clip-action-btn"
                                            Command="{Binding TogglePinCommand}"
                                            ToolTip.Tip="固定/取消固定">
                                        <Path Data="M12 17v5 M9 2h6 M9 10a5 5 0 0 0-2 4v3h10v-3a5 5 0 0 0-2-4V4h-6v6z"
                                              Width="12" Height="12"
                                              Stretch="Uniform"
                                              Stroke="{Binding PinStrokeColor}"
                                              StrokeThickness="1.75"
                                              StrokeJoin="Round"
                                              StrokeLineCap="Round"
                                              Fill="Transparent" />
                                    </Button>

                                    <!-- 删除按钮 (矢量 X) -->
                                    <Button Classes="clip-action-btn"
                                            Command="{Binding DeleteCommand}"
                                            ToolTip.Tip="删除记录">
                                        <Path Data="M18 6L6 18 M6 6l12 12"
                                              Width="11" Height="11"
                                              Stretch="Uniform"
                                              Stroke="#80FFFFFF"
                                              StrokeThickness="1.75"
                                              StrokeJoin="Round"
                                              StrokeLineCap="Round"
                                              Fill="Transparent" />
                                    </Button>

                                    <!-- 粘贴按钮 (矢量箭头) -->
                                    <Button Classes="clip-action-btn"
                                            Command="{Binding PasteCommand}"
                                            ToolTip.Tip="粘贴上屏">
                                        <Path Data="M5 12h14 M12 5l7 7-7 7"
                                              Width="11" Height="11"
                                              Stretch="Uniform"
                                              Stroke="#93C5FD"
                                              StrokeThickness="1.75"
                                              StrokeJoin="Round"
                                              StrokeLineCap="Round"
                                              Fill="Transparent" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 底部原版双行快捷键提示栏 -->
                <Border Grid.Row="3"
                        Background="#10FFFFFF"
                        BorderBrush="#18FFFFFF"
                        BorderThickness="0,1,0,0"
                        Padding="14,8">
                    <StackPanel Spacing="6">
                        <!-- 第一行：粘贴动作 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3">
                                <Border Classes="keycap"><TextBlock Classes="keycap-text" Text="Alt" /></Border>
                                <TextBlock Text="+" FontSize="11" Foreground="#50FFFFFF" VerticalAlignment="Center" />
                                <Border Classes="keycap"><TextBlock Classes="keycap-text" Text="1~9" /></Border>
                                <TextBlock Text="快速粘贴" FontSize="11" Foreground="#80FFFFFF" VerticalAlignment="Center" Margin="3,0,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Border Classes="keycap"><TextBlock Classes="keycap-text" Text="Enter" /></Border>
                                <TextBlock Text="粘贴选中" FontSize="11" Foreground="#80FFFFFF" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- 第二行：辅助操作 -->
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                <Border Classes="keycap"><TextBlock Classes="keycap-text" Text="Delete" /></Border>
                                <TextBlock Text="删除" FontSize="11" Foreground="#80FFFFFF" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="3">
                                <Border Classes="keycap"><TextBlock Classes="keycap-text" Text="Ctrl" /></Border>
                                <TextBlock Text="+" FontSize="11" Foreground="#50FFFFFF" VerticalAlignment="Center" />
                                <Border Classes="keycap"><TextBlock Classes="keycap-text" Text="F" /></Border>
                                <TextBlock Text="搜索" FontSize="11" Foreground="#80FFFFFF" VerticalAlignment="Center" Margin="3,0,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                <Border Classes="keycap"><TextBlock Classes="keycap-text" Text="Esc" /></Border>
                                <TextBlock Text="隐藏" FontSize="11" Foreground="#80FFFFFF" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Panel>
    </Border>
</Window>
