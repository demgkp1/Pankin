<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pankin.Desktop.ViewModels"
        xmlns:ai="using:Pankin.Core.Ai"
        xmlns:loc="using:Pankin.Desktop.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="484" d:DesignHeight="504"
        x:Class="Pankin.Desktop.Views.SuperPanelWindow"
        x:DataType="vm:SuperPanelViewModel"
        Width="484" Height="504"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Topmost="True"
        TransparencyLevelHint="AcrylicBlur, Blur, Transparent"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="Manual"
        CanResize="False"
        Title="{loc:Loc SuperPanel_Title}">

    <Window.Styles>
        <!-- 底部动作按钮 -->
        <Style Selector="Button.super-action-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource Pk.Radius.Control}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.super-action-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Pk.SurfaceHover}" />
        </Style>
        <Style Selector="Button.super-action-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Pk.SurfacePressed}" />
        </Style>
    </Window.Styles>

    <!-- 主玻璃面板（留白 12px 用于呈现投影） -->
    <Border Classes="frosted-panel"
            Margin="12"
            CornerRadius="{Binding PanelCornerRadius}">
        <Panel>
            <!-- 顶部柔和高光 -->
            <Border Classes="sheen" CornerRadius="{Binding PanelCornerRadius}" />

            <Grid RowDefinitions="Auto,*,Auto">
                <!-- 顶部选区引用区与关闭操作 -->
                <Border Grid.Row="0"
                        Name="TopDragArea"
                        Background="Transparent"
                        Padding="16,12,12,6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Border Grid.Column="0"
                                Padding="10,2,0,2"
                                BorderThickness="3,0,0,0"
                                BorderBrush="{DynamicResource Pk.Accent}">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding SourceAppName, StringFormat='来源: {0}'}"
                                           IsVisible="{Binding SourceAppName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Classes="caption"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Pk.AccentText}" />
                                <TextBlock Text="{Binding SourceText}"
                                           Classes="body"
                                           Foreground="{DynamicResource Pk.TextSecondary}"
                                           LineHeight="18"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- 关闭按钮 -->
                        <Button Grid.Column="1"
                                Name="CloseBtn"
                                Classes="icon-btn"
                                VerticalAlignment="Top"
                                Margin="6,0,0,0"
                                ToolTip.Tip="{loc:Loc Common_Cancel}">
                            <Path Data="M18 6L6 18 M6 6l12 12"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  StrokeThickness="1.75"
                                  StrokeJoin="Round"
                                  StrokeLineCap="Round" />
                        </Button>
                    </Grid>
                </Border>

                <!-- 中部结果卡片区 -->
                <Border Grid.Row="1"
                        Classes="card"
                        Margin="14,4,14,8"
                        Padding="14">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <!-- 卡片顶部状态行 -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                            <!-- 模式状态徽章 -->
                            <Border Grid.Column="0"
                                    Background="{DynamicResource Pk.AccentSoft}"
                                    CornerRadius="{StaticResource Pk.Radius.Control}"
                                    Padding="8,3"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding ModeTitle}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Pk.AccentText}" />
                            </Border>

                            <!-- 语言与模型信息 -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentModelName, StringFormat='中 ↔ 英 · {0}'}"
                                       Classes="caption"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- 抽屉切换按钮 -->
                            <Button Grid.Column="2"
                                    Command="{Binding ToggleSettingsCommand}"
                                    Classes="icon-btn"
                                    Width="28" Height="28"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="设置 AI 模型参数">
                                <Path Data="M4 21v-7 M4 10V3 M12 21v-9 M12 8V3 M20 21v-5 M20 12V3 M1 14h6 M9 8h6 M17 16h6"
                                      Width="13" Height="13"
                                      Stretch="Uniform"
                                      StrokeThickness="1.75"
                                      StrokeJoin="Round"
                                      StrokeLineCap="Round" />
                            </Button>
                        </Grid>

                        <!-- 主内容区域：翻译 / AI 聊天 -->
                        <Grid Grid.Row="1">
                            <!-- 模式 1：划词即时边打边翻结果 -->
                            <ScrollViewer IsVisible="{Binding !IsChatMode}"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding TranslationResult}"
                                               Classes="body"
                                               LineHeight="21"
                                               TextWrapping="Wrap" />

                                    <ProgressBar IsIndeterminate="True"
                                                 IsVisible="{Binding IsTranslating}"
                                                 Height="2"
                                                 Background="{DynamicResource Pk.SurfaceInput}"
                                                 Foreground="{DynamicResource Pk.Accent}"
                                                 Margin="0,4" />
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 模式 2：多轮 AI 对话消息历史 -->
                            <Grid IsVisible="{Binding IsChatMode}" RowDefinitions="*,Auto">
                                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Messages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ChatMessageItem">
                                                <Border Background="{Binding BackgroundBrush}"
                                                        CornerRadius="{StaticResource Pk.Radius.Control}"
                                                        Padding="10,7"
                                                        Margin="0,3">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{Binding RoleTitle}"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding RoleColor}" />
                                                        <TextBlock Text="{Binding Content}"
                                                                   Classes="body"
                                                                   LineHeight="19"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                    <TextBox Grid.Column="0"
                                             Classes="pk-input"
                                             Text="{Binding ChatInput, Mode=TwoWay}"
                                             Watermark="{loc:Loc SuperPanel_ChatPlaceholder}"
                                             FontSize="12" />

                                    <Button Grid.Column="1"
                                            Command="{Binding SendChatAsyncCommand}"
                                            IsVisible="{Binding !IsStreaming}"
                                            Classes="accent"
                                            Padding="14,7"
                                            FontSize="12"
                                            Margin="6,0,0,0">
                                        <TextBlock Text="{loc:Loc SuperPanel_Send}" />
                                    </Button>

                                    <Button Grid.Column="1"
                                            Command="{Binding CancelStreamingCommand}"
                                            IsVisible="{Binding IsStreaming}"
                                            Background="{DynamicResource Pk.DangerSoft}"
                                            Foreground="{DynamicResource Pk.Danger}"
                                            BorderThickness="0"
                                            CornerRadius="{StaticResource Pk.Radius.Control}"
                                            Padding="14,7"
                                            FontSize="12"
                                            Margin="6,0,0,0">
                                        <TextBlock Text="{loc:Loc Common_Cancel}" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- 折叠式 AI 设置抽屉 -->
                        <Border Grid.Row="2"
                                IsVisible="{Binding IsSettingsExpanded}"
                                Background="{DynamicResource Pk.SurfaceSolid}"
                                BorderBrush="{DynamicResource Pk.StrokeStrong}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Pk.Radius.Control}"
                                Padding="12"
                                Margin="0,8,0,0">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Ai_Provider}" Classes="caption" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Presets}"
                                              SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                              FontSize="11" Height="28" Margin="8,0" VerticalAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="ai:AiPreset">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="2"
                                            Command="{Binding SaveAiSettingsCommand}"
                                            Classes="accent"
                                            Padding="10,4"
                                            FontSize="11">
                                        <TextBlock Text="{loc:Loc Common_Save}" />
                                    </Button>
                                </Grid>

                                <Grid ColumnDefinitions="60,*">
                                    <TextBlock Grid.Column="0" Text="{loc:Loc SuperPanel_ApiBase}" Classes="caption" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Classes="pk-input" Text="{Binding ConfigBaseUrl, Mode=TwoWay}" FontSize="11" Height="26" Padding="6,2" />
                                </Grid>

                                <Grid ColumnDefinitions="60,*">
                                    <TextBlock Grid.Column="0" Text="{loc:Loc SuperPanel_ApiKey}" Classes="caption" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Classes="pk-input" Text="{Binding ConfigApiKey, Mode=TwoWay}" PasswordChar="•" FontSize="11" Height="26" Padding="6,2" Watermark="API Key" />
                                </Grid>

                                <Grid ColumnDefinitions="60,*">
                                    <TextBlock Grid.Column="0" Text="{loc:Loc SuperPanel_Model}" Classes="caption" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Classes="pk-input" Text="{Binding ConfigModel, Mode=TwoWay}" FontSize="11" Height="26" Padding="6,2" />
                                </Grid>

                                <TextBlock Text="{Binding SettingsStatusMessage}"
                                           IsVisible="{Binding SettingsStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Classes="caption"
                                           Foreground="{DynamicResource Pk.Success}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 底部快捷动作磁贴栏 -->
                <Border Grid.Row="2"
                        Background="{DynamicResource Pk.SurfaceFooter}"
                        BorderBrush="{DynamicResource Pk.Divider}"
                        BorderThickness="0,1,0,0"
                        Padding="8,6,8,8">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                            <Button Classes="super-action-btn"
                                    Command="{Binding CopyTranslationResultAsyncCommand}"
                                    ToolTip.Tip="复制翻译结果">
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <Path Data="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2 M9 2h6a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1z"
                                          Width="14" Height="14"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource Pk.Accent}"
                                          StrokeThickness="1.75"
                                          StrokeJoin="Round"
                                          StrokeLineCap="Round"
                                          Fill="Transparent"
                                          HorizontalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc SuperPanel_CopyTranslation}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource Pk.TextSecondary}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Classes="super-action-btn"
                                    Command="{Binding SwitchToTranslateCommand}"
                                    ToolTip.Tip="{loc:Loc SuperPanel_Action_Translate}">
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <Path Data="M5 8l6 6 M4 14l6-6 2-3 M2 5h12 M7 2h1 M22 22l-5-10-5 10 M14 18h6"
                                          Width="14" Height="14"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource Pk.Accent}"
                                          StrokeThickness="1.75"
                                          StrokeJoin="Round"
                                          StrokeLineCap="Round"
                                          Fill="Transparent"
                                          HorizontalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc SuperPanel_Action_Translate}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource Pk.TextSecondary}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Classes="super-action-btn"
                                    Command="{Binding SwitchToChatCommand}"
                                    ToolTip.Tip="{loc:Loc SuperPanel_Action_Chat}">
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <Path Data="M12 3l1.9 5.8a2 2 0 0 0 1.3 1.3L21 12l-5.8 1.9a2 2 0 0 0-1.3 1.3L12 21l-1.9-5.8a2 2 0 0 0-1.3-1.3L3 12l5.8-1.9a2 2 0 0 0 1.3-1.3L12 3z"
                                          Width="14" Height="14"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource Pk.Accent}"
                                          StrokeThickness="1.75"
                                          StrokeJoin="Round"
                                          StrokeLineCap="Round"
                                          Fill="Transparent"
                                          HorizontalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc SuperPanel_Action_Chat}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource Pk.TextSecondary}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Classes="super-action-btn"
                                    Command="{Binding SummarizeTextCommand}"
                                    ToolTip.Tip="{loc:Loc SuperPanel_Action_Summary}">
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <Path Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8"
                                          Width="14" Height="14"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource Pk.Accent}"
                                          StrokeThickness="1.75"
                                          StrokeJoin="Round"
                                          StrokeLineCap="Round"
                                          Fill="Transparent"
                                          HorizontalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc SuperPanel_Action_Summary}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource Pk.TextSecondary}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Classes="super-action-btn"
                                    Command="{Binding ExplainTextCommand}"
                                    ToolTip.Tip="{loc:Loc SuperPanel_Action_Explain}">
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <Path Data="M12 2a7 7 0 0 0-7 7c0 2.38 1.19 4.47 3 5.74V17a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-2.26c1.81-1.27 3-3.36 3-5.74a7 7 0 0 0-7-7z M9 21h6"
                                          Width="14" Height="14"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource Pk.Accent}"
                                          StrokeThickness="1.75"
                                          StrokeJoin="Round"
                                          StrokeLineCap="Round"
                                          Fill="Transparent"
                                          HorizontalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc SuperPanel_Action_Explain}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource Pk.TextSecondary}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Classes="super-action-btn"
                                    Command="{Binding CopySourceTextAsyncCommand}"
                                    ToolTip.Tip="{loc:Loc SuperPanel_CopySource}">
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <Path Data="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2 M9 2h6a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1z"
                                          Width="14" Height="14"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource Pk.Accent}"
                                          StrokeThickness="1.75"
                                          StrokeJoin="Round"
                                          StrokeLineCap="Round"
                                          Fill="Transparent"
                                          HorizontalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc SuperPanel_CopySource}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource Pk.TextSecondary}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Classes="super-action-btn"
                                    Command="{Binding SearchWebCommand}"
                                    ToolTip.Tip="{loc:Loc SuperPanel_Action_Search}">
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <Path Data="M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z M21 21l-4.35-4.35"
                                          Width="14" Height="14"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource Pk.Accent}"
                                          StrokeThickness="1.75"
                                          StrokeJoin="Round"
                                          StrokeLineCap="Round"
                                          Fill="Transparent"
                                          HorizontalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc SuperPanel_Action_Search}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource Pk.TextSecondary}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Classes="super-action-btn"
                                    Command="{Binding OpenUrlCommand}"
                                    IsVisible="{Binding IsUrl}"
                                    ToolTip.Tip="{loc:Loc SuperPanel_Action_OpenLink}">
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <Path Data="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6 M15 3h6v6 M10 14L21 3"
                                          Width="14" Height="14"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource Pk.Accent}"
                                          StrokeThickness="1.75"
                                          StrokeJoin="Round"
                                          StrokeLineCap="Round"
                                          Fill="Transparent"
                                          HorizontalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc SuperPanel_Action_OpenLink}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource Pk.TextSecondary}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Classes="super-action-btn"
                                    Command="{Binding OpenFileOrFolderCommand}"
                                    IsVisible="{Binding IsFilePath}"
                                    ToolTip.Tip="{loc:Loc SuperPanel_Action_OpenPath}">
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <Path Data="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"
                                          Width="14" Height="14"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource Pk.Accent}"
                                          StrokeThickness="1.75"
                                          StrokeJoin="Round"
                                          StrokeLineCap="Round"
                                          Fill="Transparent"
                                          HorizontalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc SuperPanel_Action_OpenPath}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource Pk.TextSecondary}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Classes="super-action-btn"
                                    Command="{Binding BatchRenameCommand}"
                                    IsVisible="{Binding CanBatchRename}"
                                    ToolTip.Tip="{loc:Loc SuperPanel_Action_BatchRename}">
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <Path Data="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"
                                          Width="14" Height="14"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource Pk.Accent}"
                                          StrokeThickness="1.75"
                                          StrokeJoin="Round"
                                          StrokeLineCap="Round"
                                          Fill="Transparent"
                                          HorizontalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc SuperPanel_Action_BatchRename}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource Pk.TextSecondary}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Panel>
    </Border>
</Window>