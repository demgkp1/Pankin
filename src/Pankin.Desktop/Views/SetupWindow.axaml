<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pankin.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="624" d:DesignHeight="504"
        x:Class="Pankin.Desktop.Views.SetupWindow"
        x:DataType="vm:SetupViewModel"
        Width="624" Height="504"
        CanResize="False"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="AcrylicBlur, Blur, Transparent"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        Title="Pankin 首次运行配置向导">

    <!-- 主玻璃面板（留白 12px 用于呈现投影） -->
    <Border Classes="frosted-panel"
            Margin="12"
            CornerRadius="{StaticResource Pk.Radius.Window}">
        <Panel>
            <!-- 顶部柔和高光 -->
            <Border Classes="sheen" CornerRadius="{StaticResource Pk.Radius.Window}" />

            <Grid RowDefinitions="52,Auto,*,56">
                <!-- 顶部拖拽栏与标题 -->
                <Border Grid.Row="0"
                        Background="Transparent"
                        x:Name="TopDragArea"
                        Padding="18,0,12,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="22" Height="22" CornerRadius="6" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Offset="0" Color="#9B8CFF" />
                                        <GradientStop Offset="1" Color="#5B6CFF" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="P" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Pankin" Classes="h2" VerticalAlignment="Center" />
                            <Border Classes="divider-v" Height="12" Margin="2,0" />
                            <TextBlock Text="首次运行配置向导" Classes="secondary" VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Classes="icon-btn"
                                Width="30" Height="30"
                                VerticalAlignment="Center"
                                ToolTip.Tip="关闭"
                                Click="OnCloseClick">
                            <Path Data="M18 6L6 18 M6 6l12 12"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  StrokeThickness="1.75"
                                  StrokeJoin="Round"
                                  StrokeLineCap="Round" />
                        </Button>
                    </Grid>
                </Border>

                <!-- 分割线 -->
                <Border Grid.Row="1" Classes="divider-h" />

                <!-- 中部向导内容区 -->
                <Border Grid.Row="2" Padding="32,20">
                    <Grid RowDefinitions="Auto,*">
                        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
                            <TextBlock Text="{Binding StepTitle}" Classes="h1" />
                            <TextBlock Text="{Binding StepDescription}" Classes="secondary" />
                        </StackPanel>

                        <!-- 步骤 0: 欢迎页 -->
                        <StackPanel Grid.Row="1" Spacing="16"
                                    IsVisible="{Binding CurrentStepIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}"
                                    VerticalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="16" HorizontalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Offset="0" Color="#9B8CFF" />
                                        <GradientStop Offset="1" Color="#5B6CFF" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="P" FontSize="36" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="欢迎使用 Pankin 桌面效率中枢" Classes="h1" HorizontalAlignment="Center"/>
                            <TextBlock Text="原生支持应用检索、剪贴板历史、划词超级面板、鼠标手势与 AI 辅助。只需简单几步，即可配置完毕。"
                                       Classes="secondary"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="440"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- 步骤 1: 语言选择 -->
                        <StackPanel Grid.Row="1" Spacing="14"
                                    IsVisible="{Binding CurrentStepIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=1}"
                                    VerticalAlignment="Center">
                            <TextBlock Text="选择显示语言 (Select Language):" Classes="body" FontWeight="SemiBold"/>
                            <RadioButton GroupName="Lang" Content="简体中文 (zh-CN)"
                                         IsChecked="{Binding Language, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=zh-CN}"/>
                            <RadioButton GroupName="Lang" Content="English (en-US)"
                                         IsChecked="{Binding Language, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=en-US}"/>
                            <RadioButton GroupName="Lang" Content="繁體中文 (zh-TW)"
                                         IsChecked="{Binding Language, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=zh-TW}"/>
                        </StackPanel>

                        <!-- 步骤 2: 依赖检测 -->
                        <Grid Grid.Row="1" RowDefinitions="*,Auto"
                              IsVisible="{Binding CurrentStepIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=2}">
                            <ListBox Grid.Row="0" ItemsSource="{Binding Dependencies}" Classes="pk-list">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="card" Padding="12,10" Margin="0,3">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock Text="{Binding Name}" Classes="body" FontWeight="Bold" Width="170" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding Description}" Classes="caption"/>
                                                    <TextBlock Text="{Binding InstallCommand}" FontSize="11" Foreground="{DynamicResource Pk.Accent}" FontFamily="Monospace"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Classes="pill" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding IsInstalled, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                               Foreground="{DynamicResource Pk.TextSecondary}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="1" Classes="secondary-btn" Content="重新检测依赖"
                                    Command="{Binding RefreshDependenciesCommand}"
                                    HorizontalAlignment="Right" Margin="0,8,0,0"/>
                        </Grid>

                        <!-- 步骤 3: 核心热键 -->
                        <StackPanel Grid.Row="1" Spacing="14"
                                    IsVisible="{Binding CurrentStepIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=3}"
                                    VerticalAlignment="Center">
                            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" Margin="0,4">
                                <TextBlock Text="启动器快捷键:" Classes="body" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Classes="pk-input" Text="{Binding LauncherHotkey}" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="1" Text="剪贴板快捷键:" Classes="body" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Classes="pk-input" Text="{Binding ClipboardHotkey}"/>
                            </Grid>
                            <TextBlock Text="提示：如快捷键与系统桌面冲突，可随时在设置界面中重新修改。" Classes="caption"/>
                        </StackPanel>

                        <!-- 步骤 4: AI 提供商配置 -->
                        <StackPanel Grid.Row="1" Spacing="12"
                                    IsVisible="{Binding CurrentStepIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=4}">
                            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4">
                                <TextBlock Text="AI 提供商:" Classes="body" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                    <ComboBoxItem Content="DeepSeek (推荐)"/>
                                    <ComboBoxItem Content="OpenAI"/>
                                    <ComboBoxItem Content="Ollama 本地大模型"/>
                                </ComboBox>

                                <TextBlock Grid.Row="1" Text="API 基础地址:" Classes="body" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Classes="pk-input" Text="{Binding AiBaseUrl}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Text="API 密钥 (Key):" Classes="body" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Classes="pk-input" Text="{Binding AiApiKey}" PasswordChar="●" Watermark="sk-..." Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="3" Text="默认模型名称:" Classes="body" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Classes="pk-input" Text="{Binding AiModel}"/>
                            </Grid>
                        </StackPanel>

                        <!-- 步骤 5: 自启动设置 -->
                        <StackPanel Grid.Row="1" Spacing="16"
                                    IsVisible="{Binding CurrentStepIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=5}"
                                    VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding Autostart}" Content="开机与登录时自动启动 Pankin" FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock Text="启用后，系统将在 ~/.config/autostart 中创建 pankin.desktop 文件，每次登录自动就绪服务。"
                                       Classes="secondary"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- 步骤 6: 完成页 -->
                        <StackPanel Grid.Row="1" Spacing="16"
                                    IsVisible="{Binding CurrentStepIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=6}"
                                    VerticalAlignment="Center">
                            <TextBlock Text="🎉 恭喜，初始化设置已完成！" Classes="h1" HorizontalAlignment="Center" Foreground="{DynamicResource Pk.Success}"/>
                            <TextBlock Text="点击下方完成按钮，Pankin 将以您的个性化偏好启动并常驻后台。可在托盘或通过快捷键随时唤醒。"
                                       Classes="secondary"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       MaxWidth="440"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 底部导航栏 -->
                <Border Grid.Row="3"
                        Background="{DynamicResource Pk.SurfaceFooter}"
                        BorderBrush="{DynamicResource Pk.Divider}"
                        BorderThickness="0,1,0,0"
                        Padding="24,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Classes="secondary-btn" Content="上一步" Command="{Binding PreviousCommand}" IsVisible="{Binding CanGoPrevious}" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Button Classes="accent" Content="下一步" Command="{Binding NextCommand}" IsVisible="{Binding !IsLastStep}"/>
                            <Button Classes="accent" Content="完成并进入 Pankin" Command="{Binding CompleteSetupCommand}" IsVisible="{Binding IsLastStep}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Panel>
    </Border>
</Window>