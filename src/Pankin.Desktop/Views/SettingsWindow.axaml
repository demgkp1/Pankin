<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pankin.Desktop.ViewModels"
        xmlns:vmm="using:Pankin.Desktop.ViewModels.Modules"
        xmlns:vmu="using:Pankin.Desktop.ViewModels.Updates"
        xmlns:ai="using:Pankin.Core.Ai"
        xmlns:loc="using:Pankin.Desktop.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="904" d:DesignHeight="624"
        x:Class="Pankin.Desktop.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Width="904" Height="624"
        ShowInTaskbar="True"
        SystemDecorations="None"
        Topmost="False"
        TransparencyLevelHint="AcrylicBlur, Blur, Transparent"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Title="{loc:Loc Settings_Title}">

    <Window.Styles>
        <!-- 侧边栏导航按钮 -->
        <Style Selector="Button.nav-tab-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Pk.TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="{StaticResource Pk.Radius.Control}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav-tab-btn Path">
            <Setter Property="Stroke" Value="{DynamicResource Pk.TextSecondary}" />
        </Style>
        <Style Selector="Button.nav-tab-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Pk.SurfaceHover}" />
            <Setter Property="Foreground" Value="{DynamicResource Pk.Text}" />
        </Style>
        <Style Selector="Button.nav-tab-btn:pointerover Path">
            <Setter Property="Stroke" Value="{DynamicResource Pk.Text}" />
        </Style>
        <Style Selector="Button.nav-tab-btn.selected">
            <Setter Property="Background" Value="{DynamicResource Pk.AccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource Pk.AccentText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.nav-tab-btn.selected Path">
            <Setter Property="Stroke" Value="{DynamicResource Pk.AccentText}" />
        </Style>

        <!-- 快捷延时 pill 按钮 -->
        <Style Selector="Button.quick-pick-btn">
            <Setter Property="Background" Value="{DynamicResource Pk.SurfaceInput}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Pk.Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Pk.Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="{StaticResource Pk.Radius.Control}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.quick-pick-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Pk.AccentSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Pk.AccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource Pk.AccentText}" />
        </Style>
    </Window.Styles>

    <!-- 主玻璃面板（留白 12px 用于呈现投影） -->
    <Border Classes="frosted-panel"
            Margin="12"
            CornerRadius="{Binding PanelCornerRadius}">
        <Panel>
            <!-- 顶部柔和高光 -->
            <Border Classes="sheen" CornerRadius="{Binding PanelCornerRadius}" />

            <Grid ColumnDefinitions="210,*">
                <!-- 左侧导航栏 -->
                <Border Grid.Column="0"
                        Name="LeftNavBorder"
                        Background="{DynamicResource Pk.SurfaceSidebar}"
                        BorderBrush="{DynamicResource Pk.Divider}"
                        BorderThickness="0,0,1,0"
                        Padding="12,16">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <!-- 顶部 Logo 与标题 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="9" Margin="6,4,6,16">
                            <Border Width="24" Height="24" CornerRadius="6" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Offset="0" Color="#9B8CFF" />
                                        <GradientStop Offset="1" Color="#5B6CFF" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="P" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Pankin 设置" Classes="h2" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 选项卡列表 -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding NavTabs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NavTabItem">
                                        <Button Command="{Binding SelectCommand}"
                                                Classes="nav-tab-btn"
                                                Classes.selected="{Binding IsSelected}"
                                                IsVisible="{Binding IsVisible}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Path Data="{Binding IconGeometry}"
                                                      Width="15" Height="15"
                                                      Stretch="Uniform"
                                                      StrokeThickness="1.75"
                                                      StrokeJoin="Round"
                                                      StrokeLineCap="Round"
                                                      Fill="Transparent"
                                                      VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12.5"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 底部版本信息 -->
                        <TextBlock Grid.Row="2"
                                   Text="Pankin v0.3.2 (Ubuntu 24.04)"
                                   Classes="caption"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0" />
                    </Grid>
                </Border>

                <!-- 右侧设置工作区 -->
                <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="24,16,24,20">
                    <!-- 顶部关闭按钮 -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Button Name="CloseButton"
                                Classes="icon-btn"
                                HorizontalAlignment="Right"
                                ToolTip.Tip="{loc:Loc Common_Cancel}">
                            <Path Data="M18 6L6 18 M6 6l12 12"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  StrokeThickness="1.75"
                                  StrokeJoin="Round"
                                  StrokeLineCap="Round" />
                        </Button>
                    </Grid>

                    <!-- 11 个选项卡内容 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Panel>
                            <!-- Tab 0: 通用 -->
                            <StackPanel Spacing="16" IsVisible="{Binding IsTabGeneral}">
                                <TextBlock Text="{loc:Loc Settings_Appearance}" Classes="h1" />

                                <Border Classes="module-card">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Loc Settings_Language}" Classes="body" FontWeight="Medium" />
                                                <TextBlock Text="{loc:Loc Settings_Language_System}" Classes="caption" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" Width="150" FontSize="12" />
                                        </Grid>

                                        <Border Classes="divider-h" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Loc Settings_Theme}" Classes="body" FontWeight="Medium" />
                                                <TextBlock Text="{loc:Loc Settings_Theme_System}" Classes="caption" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" Width="150" FontSize="12" />
                                        </Grid>

                                        <Border Classes="divider-h" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="主题强调色" Classes="body" FontWeight="Medium" />
                                                <TextBlock Text="全局高亮、焦点边框与活动项强调配色" Classes="caption" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Background="#8B8DFF" Width="26" Height="26" CornerRadius="13" Padding="0" Command="{Binding SelectAccentColorCommand}" CommandParameter="#8B8DFF" ToolTip.Tip="靛紫" />
                                                <Button Background="#5874C9" Width="26" Height="26" CornerRadius="13" Padding="0" Command="{Binding SelectAccentColorCommand}" CommandParameter="#5874C9" ToolTip.Tip="雾蓝" />
                                                <Button Background="#17958B" Width="26" Height="26" CornerRadius="13" Padding="0" Command="{Binding SelectAccentColorCommand}" CommandParameter="#17958B" ToolTip.Tip="青碧" />
                                                <Button Background="#5F8F4E" Width="26" Height="26" CornerRadius="13" Padding="0" Command="{Binding SelectAccentColorCommand}" CommandParameter="#5F8F4E" ToolTip.Tip="苔绿" />
                                                <Button Background="#E07A5F" Width="26" Height="26" CornerRadius="13" Padding="0" Command="{Binding SelectAccentColorCommand}" CommandParameter="#E07A5F" ToolTip.Tip="琥珀" />
                                                <Button Background="#D946EF" Width="26" Height="26" CornerRadius="13" Padding="0" Command="{Binding SelectAccentColorCommand}" CommandParameter="#D946EF" ToolTip.Tip="玫瑰" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Classes="divider-h" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="面板不透明度" Classes="body" FontWeight="Medium" />
                                                <TextBlock Text="调节玻璃窗口质感与背景透光程度" Classes="caption" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Slider Width="120" Minimum="40" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PanelOpacityPercent, Mode=TwoWay}" VerticalAlignment="Center" />
                                                <NumericUpDown Classes="pk-num" ShowButtonSpinner="False" FormatString="0" Increment="1" Value="{Binding PanelOpacityPercent}" Minimum="40" Maximum="100" VerticalAlignment="Center" />
                                                <TextBlock Text="%" Classes="caption" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Classes="divider-h" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Loc Settings_PanelRadius}" Classes="body" FontWeight="Medium" />
                                                <TextBlock Text="{loc:Loc Settings_PanelRadius_Large}" Classes="caption" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Classes="ghost" Padding="6,2" FontSize="11" Content="8px" Command="{Binding SetPanelRadiusCommand}" CommandParameter="8" />
                                                <Button Classes="ghost" Padding="6,2" FontSize="11" Content="16px" Command="{Binding SetPanelRadiusCommand}" CommandParameter="16" />
                                                <Button Classes="ghost" Padding="6,2" FontSize="11" Content="24px" Command="{Binding SetPanelRadiusCommand}" CommandParameter="24" />
                                                <Slider Width="90" Minimum="0" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PanelRadius, Mode=TwoWay}" VerticalAlignment="Center" />
                                                <NumericUpDown Classes="pk-num" ShowButtonSpinner="False" FormatString="0" Increment="1" Value="{Binding PanelRadius}" Minimum="0" Maximum="32" VerticalAlignment="Center" />
                                                <TextBlock Text="px" Classes="caption" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Classes="divider-h" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Loc Settings_StartAtLogin}" Classes="body" FontWeight="Medium" />
                                                <TextBlock Text="{loc:Loc Settings_StartAtLogin_Description}" Classes="caption" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartAtLogin, Mode=TwoWay}" OnContent="" OffContent="" />
                                        </Grid>

                                        <Border Classes="divider-h" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Loc Settings_ShowTrayIcon}" Classes="body" FontWeight="Medium" />
                                                <TextBlock Text="{loc:Loc Settings_ShowTrayIcon_Description}" Classes="caption" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowTrayIcon, Mode=TwoWay}" OnContent="" OffContent="" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Classes="module-card">
                                    <StackPanel Spacing="14">
                                        <TextBlock Text="面板窗口交互行为" Classes="section" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="失焦自动隐匿" Classes="body" FontWeight="Medium" />
                                                <TextBlock Text="点击启动器或剪贴板面板外部任何区域时自动隐藏" Classes="caption" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding HideOnDeactivate, Mode=TwoWay}" OnContent="" OffContent="" />
                                        </Grid>

                                        <Border Classes="divider-h" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="记住面板拖动位置" Classes="body" FontWeight="Medium" />
                                                <TextBlock Text="拖拽移动面板后保持记忆，下次在相同屏幕坐标呼出" Classes="caption" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <Button Classes="ghost" FontSize="11" Padding="8,4" Content="重置居中" Command="{Binding ResetWindowPositionCommand}" />
                                                <ToggleSwitch IsChecked="{Binding RememberWindowPosition, Mode=TwoWay}" OnContent="" OffContent="" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Tab 1: 能力网格 (ModulesSettingsViewModel) -->
                            <StackPanel Spacing="12" IsVisible="{Binding IsTabModules}">
                                <TextBlock Text="能力模块总览" Classes="h1" />
                                <TextBlock Text="只开你要用的。停用的能力不占热键、不装钩子，设置也从左边收起。" Classes="secondary" Margin="0,0,0,8" />

                                <!-- 连带依赖变动确认提示横幅 -->
                                <Border Classes="module-card"
                                        Background="{DynamicResource Pk.AccentSoft}"
                                        BorderBrush="{DynamicResource Pk.Accent}"
                                        IsVisible="{Binding ModulesSettings.HasPendingConfirm}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{Binding ModulesSettings.ConfirmMessage}"
                                                   Classes="body"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="确认并应用"
                                                    Command="{Binding ModulesSettings.ConfirmChangeCommand}"
                                                    Classes="accent"
                                                    Padding="14,6"
                                                    FontSize="12" />
                                            <Button Content="取消"
                                                    Command="{Binding ModulesSettings.CancelConfirmCommand}"
                                                    Classes="secondary-btn"
                                                    Padding="14,6"
                                                    FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding ModulesSettings.Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vmm:ModuleItemViewModel">
                                            <Border Classes="module-card" MinHeight="110" Margin="4,4">
                                                <Grid RowDefinitions="Auto,*,Auto">
                                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                                        <Border Grid.Column="0"
                                                                Classes="icon-badge"
                                                                Width="30" Height="30"
                                                                Background="{DynamicResource Pk.AccentSoft}"
                                                                Margin="0,0,10,0">
                                                            <Path Data="{Binding IconGeometry}"
                                                                  Width="16" Height="16"
                                                                  Stretch="Uniform"
                                                                  Stroke="{DynamicResource Pk.Accent}"
                                                                  StrokeThickness="1.75"
                                                                  StrokeJoin="Round"
                                                                  StrokeLineCap="Round"
                                                                  Fill="Transparent"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="body" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <Button Grid.Column="2"
                                                                Command="{Binding ToggleCommand}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="0">
                                                            <ToggleSwitch IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                                          IsHitTestVisible="False"
                                                                          OnContent="" OffContent="" />
                                                        </Button>
                                                    </Grid>

                                                    <TextBlock Grid.Row="1" Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" Margin="0,8,0,8" LineHeight="17" />

                                                    <TextBlock Grid.Row="2"
                                                               IsVisible="{Binding HasProblem}"
                                                               Text="{Binding Problem}"
                                                               Classes="caption"
                                                               Foreground="{DynamicResource Pk.Danger}"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Tab 2: 启动器 -->
                            <StackPanel Spacing="16" IsVisible="{Binding IsTabLauncher}">
                                <TextBlock Text="启动器偏好设置" Classes="h1" />

                                <Border Classes="module-card">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="主唤醒快捷键" Classes="body" FontWeight="Medium" />
                                                <TextBlock Text="随时随地快速呼出应用启动器面板" Classes="caption" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Border Classes="keycap" Background="{DynamicResource Pk.AccentSoft}" BorderBrush="{DynamicResource Pk.Accent}">
                                                    <TextBlock Classes="keycap-text" Text="{Binding LauncherHotkey}" FontWeight="SemiBold" Foreground="{DynamicResource Pk.Accent}" />
                                                </Border>
                                                <Button Classes="ghost" FontSize="11" Padding="8,4"
                                                        Command="{Binding StartRecordingCommand}" CommandParameter="Launcher"
                                                        Content="{Binding LauncherRecordButtonText}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="快捷预设:" Classes="caption" VerticalAlignment="Center" />
                                            <Button Classes="ghost" Padding="6,2" FontSize="11" Content="Ctrl+Space" Command="{Binding SetLauncherPresetCommand}" CommandParameter="Ctrl+Space" />
                                            <Button Classes="ghost" Padding="6,2" FontSize="11" Content="Alt+Space" Command="{Binding SetLauncherPresetCommand}" CommandParameter="Alt+Space" />
                                            <Button Classes="ghost" Padding="6,2" FontSize="11" Content="Super+Space" Command="{Binding SetLauncherPresetCommand}" CommandParameter="Super+Space" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Classes="module-card">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="搜索文件时集成 plocate" Classes="body" FontWeight="Medium" />
                                                <TextBlock Text="全盘极速检索文件，前缀加 'f ' 专门搜索文件路径" Classes="caption" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableFileSearch, Mode=TwoWay}" OnContent="" OffContent="" />
                                        </Grid>

                                        <Border Classes="divider-h" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="即时算式计算器" Classes="body" FontWeight="Medium" />
                                                <TextBlock Text="输入如 sqrt(16)+2^3 时，自动置顶卡片计算结果" Classes="caption" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableCalculator, Mode=TwoWay}" OnContent="" OffContent="" />
                                        </Grid>

                                        <Border Classes="divider-h" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="首页最近使用应用数量" Classes="body" FontWeight="Medium" />
                                                <TextBlock Text="控制启动器首页快捷宫格中显示的应用个数 (1-28)" Classes="caption" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Slider Width="120" Minimum="1" Maximum="28" Value="{Binding MaxRecentApps, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                                <NumericUpDown Classes="pk-num" ShowButtonSpinner="False" FormatString="0" Increment="1" Value="{Binding MaxRecentApps}" Minimum="1" Maximum="28" VerticalAlignment="Center" />
                                                <TextBlock Text="个" Classes="caption" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Classes="divider-h" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="应用搜索最大行数" Classes="body" FontWeight="Medium" />
                                                <TextBlock Text="控制启动器搜索结果中最多显示的应用结果行数 (1-10)" Classes="caption" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Slider Width="120" Minimum="1" Maximum="10" Value="{Binding MaxAppRows, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                                <NumericUpDown Classes="pk-num" ShowButtonSpinner="False" FormatString="0" Increment="1" Value="{Binding MaxAppRows}" Minimum="1" Maximum="10" VerticalAlignment="Center" />
                                                <TextBlock Text="行" Classes="caption" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Classes="divider-h" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="文件搜索最大行数" Classes="body" FontWeight="Medium" />
                                                <TextBlock Text="控制启动器搜索结果中最多显示的文件结果行数 (1-20)" Classes="caption" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Slider Width="120" Minimum="1" Maximum="20" Value="{Binding MaxFileRows, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                                <NumericUpDown Classes="pk-num" ShowButtonSpinner="False" FormatString="0" Increment="1" Value="{Binding MaxFileRows}" Minimum="1" Maximum="20" VerticalAlignment="Center" />
                                                <TextBlock Text="行" Classes="caption" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Tab 3: 剪贴板 -->
                            <StackPanel Spacing="16" IsVisible="{Binding IsTabClipboard}">
                                <TextBlock Text="剪贴板历史偏好设置" Classes="h1" />

                                <Border Classes="module-card">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="快速唤出热键" Classes="body" FontWeight="Medium" />
                                                <TextBlock Text="随时随地呼出紧凑历史记录面板" Classes="caption" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Border Classes="keycap" Background="{DynamicResource Pk.AccentSoft}" BorderBrush="{DynamicResource Pk.Accent}">
                                                    <TextBlock Classes="keycap-text" Text="{Binding ClipboardHotkey}" FontWeight="SemiBold" Foreground="{DynamicResource Pk.Accent}" />
                                                </Border>
                                                <Button Classes="ghost" FontSize="11" Padding="8,4"
                                                        Command="{Binding StartRecordingCommand}" CommandParameter="Clipboard"
                                                        Content="{Binding ClipboardRecordButtonText}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="快捷预设:" Classes="caption" VerticalAlignment="Center" />
                                            <Button Classes="ghost" Padding="6,2" FontSize="11" Content="Alt+V" Command="{Binding SetClipboardPresetCommand}" CommandParameter="Alt+V" />
                                            <Button Classes="ghost" Padding="6,2" FontSize="11" Content="Ctrl+Alt+V" Command="{Binding SetClipboardPresetCommand}" CommandParameter="Ctrl+Alt+V" />
                                            <Button Classes="ghost" Padding="6,2" FontSize="11" Content="Alt+C" Command="{Binding SetClipboardPresetCommand}" CommandParameter="Alt+C" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Classes="module-card">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="最大保留记录数" Classes="body" FontWeight="Medium" />
                                                <TextBlock Text="历史记录存储在本地 SQLite 数据库中" Classes="caption" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Slider Width="120" Minimum="10" Maximum="2000" Value="{Binding ClipboardMaxItems, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                                <NumericUpDown Classes="pk-num" ShowButtonSpinner="False" FormatString="0" Increment="1" Value="{Binding ClipboardMaxItems}" Minimum="10" Maximum="2000" VerticalAlignment="Center" />
                                                <TextBlock Text="条" Classes="caption" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Tab 4: 鼠标手势 (已移除，保持隐藏) -->
                            <StackPanel Spacing="16" IsVisible="False">
                            </StackPanel>

                            <!-- Tab 5: 超级面板 -->
                            <StackPanel Spacing="16" IsVisible="{Binding IsTabSuperPanel}">
                                <TextBlock Text="{loc:Loc Settings_NavSuperPanel}" Classes="h1" />

                                <Border Classes="module-card">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="全局唤醒热键" Classes="body" FontWeight="Medium" />
                                                <TextBlock Text="就近鼠标指针处呼出划词操作与 AI 翻译面板" Classes="caption" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Border Classes="keycap" Background="{DynamicResource Pk.AccentSoft}" BorderBrush="{DynamicResource Pk.Accent}">
                                                    <TextBlock Classes="keycap-text" Text="{Binding SuperPanelHotkey}" FontWeight="SemiBold" Foreground="{DynamicResource Pk.Accent}" />
                                                </Border>
                                                <Button Classes="ghost" FontSize="11" Padding="8,4"
                                                        Command="{Binding StartRecordingCommand}" CommandParameter="SuperPanel"
                                                        Content="{Binding SuperPanelRecordButtonText}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="快捷预设:" Classes="caption" VerticalAlignment="Center" />
                                            <Button Classes="ghost" Padding="6,2" FontSize="11" Content="Alt+S" Command="{Binding SetSuperPanelPresetCommand}" CommandParameter="Alt+S" />
                                            <Button Classes="ghost" Padding="6,2" FontSize="11" Content="Ctrl+Shift+S" Command="{Binding SetSuperPanelPresetCommand}" CommandParameter="Ctrl+Shift+S" />
                                            <Button Classes="ghost" Padding="6,2" FontSize="11" Content="Alt+D" Command="{Binding SetSuperPanelPresetCommand}" CommandParameter="Alt+D" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Classes="module-card">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Loc Settings_Super_AutoTranslate}" Classes="body" FontWeight="Medium" />
                                                <TextBlock Text="{loc:Loc Settings_Super_AutoTranslate_Description}" Classes="caption" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoTranslateSelection, Mode=TwoWay}" OnContent="" OffContent="" />
                                        </Grid>

                                        <Border Classes="divider-h" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Loc Settings_Super_PauseFullscreen}" Classes="body" FontWeight="Medium" />
                                                <TextBlock Text="全屏窗口活跃时忽略划词与按键响应" Classes="caption" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding PauseInFullscreen, Mode=TwoWay}" OnContent="" OffContent="" />
                                        </Grid>

                                        <Border Classes="divider-h" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="长按触发耗时" Classes="body" FontWeight="Medium" />
                                                <TextBlock Text="呼出超级面板的长按判定时长 (毫秒)" Classes="caption" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Slider Width="100" Minimum="100" Maximum="1000" Value="{Binding SuperPanelHoldDuration, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                                <NumericUpDown Classes="pk-num" ShowButtonSpinner="False" FormatString="0" Increment="1" Value="{Binding SuperPanelHoldDuration}" Minimum="100" Maximum="1000" VerticalAlignment="Center" />
                                                <TextBlock Text="ms" Classes="caption" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Classes="divider-h" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Loc Settings_Super_MinLength}" Classes="body" FontWeight="Medium" />
                                                <TextBlock Text="触发超级面板的最小划词字符数" Classes="caption" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Slider Width="100" Minimum="1" Maximum="50" Value="{Binding SelectionMinLength, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                                <NumericUpDown Classes="pk-num" ShowButtonSpinner="False" FormatString="0" Increment="1" Value="{Binding SelectionMinLength}" Minimum="1" Maximum="50" VerticalAlignment="Center" />
                                                <TextBlock Text="字" Classes="caption" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Classes="divider-h" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Loc Settings_Super_MaxLength}" Classes="body" FontWeight="Medium" />
                                                <TextBlock Text="允许自动选词响应的最大字符数" Classes="caption" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Slider Width="100" Minimum="50" Maximum="10000" Value="{Binding SelectionMaxLength, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                                <NumericUpDown Classes="pk-num" ShowButtonSpinner="False" FormatString="0" Increment="1" Value="{Binding SelectionMaxLength}" Minimum="50" Maximum="10000" VerticalAlignment="Center" />
                                                <TextBlock Text="字" Classes="caption" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Classes="divider-h" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="手动呼出热键" Classes="body" FontWeight="Medium" />
                                                <TextBlock Text="选中文字后立即唤醒" Classes="caption" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Classes="keycap"><TextBlock Classes="keycap-text" Text="Alt + S" /></Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Classes="module-card">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{loc:Loc Settings_Super_Blacklist}" Classes="body" FontWeight="Medium" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0"
                                                     Classes="pk-input"
                                                     Text="{Binding BlacklistedAppsInput, Mode=TwoWay}"
                                                     Watermark="{loc:Loc Settings_Super_Blacklist_Placeholder}"
                                                     FontSize="12" />
                                            <Button Grid.Column="1"
                                                    Command="{Binding AddBlacklistedAppCommand}"
                                                    Classes="accent"
                                                    Padding="12,6"
                                                    FontSize="12"
                                                    Margin="8,0,0,0">
                                                <TextBlock Text="{loc:Loc Common_Add}" />
                                            </Button>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding BlacklistedApps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                        <TextBlock Grid.Column="0" Text="{Binding}" Classes="body" VerticalAlignment="Center" />
                                                        <Button Grid.Column="1"
                                                                Command="{Binding $parent[Window].DataContext.RemoveBlacklistedAppCommand}"
                                                                CommandParameter="{Binding}"
                                                                Background="{DynamicResource Pk.DangerSoft}"
                                                                Foreground="{DynamicResource Pk.Danger}"
                                                                BorderThickness="0"
                                                                CornerRadius="{StaticResource Pk.Radius.Control}"
                                                                Padding="8,3"
                                                                FontSize="11">
                                                            <TextBlock Text="{loc:Loc Common_Remove}" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Tab 6: 文件夹跳转 (FolderJump) -->
                            <StackPanel Spacing="16" IsVisible="{Binding IsTabFolderJump}">
                                <TextBlock Text="文件夹快速跳转收藏" Classes="h1" />
                                <TextBlock Text="收藏常用目录，在启动器和文件对话框中一键直达" Classes="secondary" Margin="0,0,0,4" />

                                <Border Classes="module-card">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0"
                                                     Classes="pk-input"
                                                     Text="{Binding NewFavoriteFolderPath, Mode=TwoWay}"
                                                     Watermark="输入或粘贴目录绝对路径 (如 /home/user/Work)..."
                                                     FontSize="12" />
                                            <Button Grid.Column="1"
                                                    Command="{Binding AddFavoriteFolderCommand}"
                                                    Classes="accent"
                                                    Padding="14,6"
                                                    FontSize="12"
                                                    Margin="8,0,0,0">
                                                <TextBlock Text="添加收藏" />
                                            </Button>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding FavoriteFolders}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3">
                                                        <TextBlock Grid.Column="0" Text="{Binding}" Classes="body" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <Button Grid.Column="1"
                                                                Command="{Binding $parent[Window].DataContext.OpenFavoriteFolderCommand}"
                                                                CommandParameter="{Binding}"
                                                                Classes="secondary-btn"
                                                                Padding="10,4"
                                                                FontSize="11"
                                                                Margin="6,0">
                                                            <TextBlock Text="打开" />
                                                        </Button>
                                                        <Button Grid.Column="2"
                                                                Command="{Binding $parent[Window].DataContext.RemoveFavoriteFolderCommand}"
                                                                CommandParameter="{Binding}"
                                                                Background="{DynamicResource Pk.DangerSoft}"
                                                                Foreground="{DynamicResource Pk.Danger}"
                                                                BorderThickness="0"
                                                                CornerRadius="{StaticResource Pk.Radius.Control}"
                                                                Padding="10,4"
                                                                FontSize="11">
                                                            <TextBlock Text="移除" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Tab 7: 批量重命名 (BatchRename) -->
                            <StackPanel Spacing="16" IsVisible="{Binding IsTabBatchRename}">
                                <TextBlock Text="文件批量重命名" Classes="h1" />
                                <TextBlock Text="一次给多个文件改名：查找替换、添加前后缀、自动编号，先预览后执行" Classes="secondary" Margin="0,0,0,4" />

                                <Border Classes="module-card">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0"
                                                     Classes="pk-input"
                                                     Text="{Binding RenameFolderPath, Mode=TwoWay}"
                                                     Watermark="输入待处理文件夹绝对路径 (如 /home/user/Downloads)..."
                                                     FontSize="12" />
                                            <Button Grid.Column="1"
                                                    Command="{Binding LoadRenameFilesCommand}"
                                                    Classes="secondary-btn"
                                                    Padding="14,6"
                                                    FontSize="12"
                                                    Margin="8,0,0,0">
                                                <TextBlock Text="扫描加载" />
                                            </Button>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="查找替换文字:" Classes="caption" Margin="0,0,0,4" />
                                                <Grid ColumnDefinitions="*,*">
                                                    <TextBox Grid.Column="0" Classes="pk-input" Text="{Binding RenameFindText, Mode=TwoWay}" Watermark="查找字符..." FontSize="11" Margin="0,0,3,0" />
                                                    <TextBox Grid.Column="1" Classes="pk-input" Text="{Binding RenameReplaceText, Mode=TwoWay}" Watermark="替换为..." FontSize="11" Margin="3,0,0,0" />
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="添加前缀 / 后缀:" Classes="caption" Margin="0,0,0,4" />
                                                <Grid ColumnDefinitions="*,*">
                                                    <TextBox Grid.Column="0" Classes="pk-input" Text="{Binding RenamePrefix, Mode=TwoWay}" Watermark="前缀..." FontSize="11" Margin="0,0,3,0" />
                                                    <TextBox Grid.Column="1" Classes="pk-input" Text="{Binding RenameSuffix, Mode=TwoWay}" Watermark="后缀..." FontSize="11" Margin="3,0,0,0" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <CheckBox IsChecked="{Binding RenameEnableNumbering, Mode=TwoWay}" Content="启用自动编号" VerticalAlignment="Center" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="起始编号:" Classes="caption" VerticalAlignment="Center" />
                                                <NumericUpDown Classes="pk-num" ShowButtonSpinner="False" FormatString="0" Increment="1" Value="{Binding RenameStartNumber}" Minimum="0" Maximum="99999" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Background="{DynamicResource Pk.SurfaceInput}"
                                                BorderBrush="{DynamicResource Pk.Stroke}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource Pk.Radius.Control}"
                                                Height="120"
                                                Padding="6">
                                            <ScrollViewer>
                                                <ItemsControl ItemsSource="{Binding RenamePreviews}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:RenameFilePreviewItem">
                                                            <Grid ColumnDefinitions="*,Auto,*" Margin="6,3">
                                                                <TextBlock Grid.Column="0" Text="{Binding OriginalName}" Classes="caption" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1" Text=" → " Classes="caption" Foreground="{DynamicResource Pk.Accent}" Margin="6,0" />
                                                                <TextBlock Grid.Column="2" Text="{Binding NewName}" Classes="caption" Foreground="{DynamicResource Pk.Success}" TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>

                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding RenameStatusMessage}" Classes="caption" VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Command="{Binding ExecuteRenameCommand}"
                                                    Classes="accent"
                                                    Padding="16,6"
                                                    FontSize="12">
                                                <TextBlock Text="执行批量重命名" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Tab 8: 定时关机 (PowerTimer) -->
                            <StackPanel Spacing="16" IsVisible="{Binding IsTabPowerTimer}">
                                <TextBlock Text="定时关机 / 电源任务" Classes="h1" />
                                <TextBlock Text="到点关机、重启、睡眠或锁屏；到点前 1 分钟提醒，可以随时取消或推迟。" Classes="secondary" Margin="0,0,0,4" />

                                <!-- 状态卡：有定时任务时展示 -->
                                <Border Classes="module-card"
                                        IsVisible="{Binding IsPowerTimerArmed}"
                                        Background="{DynamicResource Pk.AccentSoft}"
                                        BorderBrush="{DynamicResource Pk.Accent}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding PowerTimerRemainingText}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource Pk.AccentText}" />
                                            <TextBlock Text="{Binding PowerTimerTargetAtText}" Classes="caption" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Command="{Binding CancelPowerTimerCommand}"
                                                Background="{DynamicResource Pk.DangerSoft}"
                                                Foreground="{DynamicResource Pk.Danger}"
                                                BorderThickness="0"
                                                CornerRadius="{StaticResource Pk.Radius.Control}"
                                                Padding="14,8"
                                                FontSize="12"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="取消定时" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- 动作与时长配置卡 -->
                                <Border Classes="module-card">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnDefinitions="100,*">
                                            <TextBlock Grid.Column="0" Text="执行动作:" Classes="body" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding PowerActions}" SelectedItem="{Binding SelectedPowerAction, Mode=TwoWay}" FontSize="12" Width="180" />
                                        </Grid>

                                        <Border Classes="divider-h" />

                                        <Grid ColumnDefinitions="100,*">
                                            <TextBlock Grid.Column="0" Text="快捷延时:" Classes="body" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Classes="quick-pick-btn" Content="15 分钟" Command="{Binding SetQuickDelayCommand}" CommandParameter="15" />
                                                <Button Classes="quick-pick-btn" Content="30 分钟" Command="{Binding SetQuickDelayCommand}" CommandParameter="30" />
                                                <Button Classes="quick-pick-btn" Content="60 分钟" Command="{Binding SetQuickDelayCommand}" CommandParameter="60" />
                                                <Button Classes="quick-pick-btn" Content="120 分钟" Command="{Binding SetQuickDelayCommand}" CommandParameter="120" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Classes="divider-h" />

                                        <Grid ColumnDefinitions="100,*,Auto">
                                            <TextBlock Grid.Column="0" Text="自定义时长:" Classes="body" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="1" Maximum="1440" Value="{Binding PowerTimerMinutes, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <NumericUpDown Classes="pk-num" ShowButtonSpinner="False" FormatString="0" Increment="1" Value="{Binding PowerTimerMinutes}" Minimum="1" Maximum="1440" VerticalAlignment="Center" />
                                                <TextBlock Text="分钟" Classes="caption" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Classes="divider-h" />

                                        <Grid ColumnDefinitions="100,*">
                                            <Border Grid.Column="0" />
                                            <Button Grid.Column="1"
                                                    Command="{Binding ArmPowerTimerCommand}"
                                                    Classes="accent"
                                                    Padding="20,8"
                                                    FontSize="13"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="定好 (开始倒计时)" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Tab 9: AI 服务 -->
                            <StackPanel Spacing="16" IsVisible="{Binding IsTabAi}">
                                <TextBlock Text="{loc:Loc Settings_NavAi}" Classes="h1" />

                                <Border Classes="module-card">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="120,*">
                                            <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Ai_Provider}" Classes="body" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding AiPresetsList}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" FontSize="12">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="ai:AiPreset">
                                                        <TextBlock Text="{Binding Name}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>

                                        <Border Classes="divider-h" />

                                        <Grid ColumnDefinitions="120,*">
                                            <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Ai_BaseUrl}" Classes="body" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Classes="pk-input" Text="{Binding AiBaseUrl, Mode=TwoWay}" FontSize="12" />
                                        </Grid>

                                        <Border Classes="divider-h" />

                                        <Grid ColumnDefinitions="120,*">
                                            <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Ai_ApiKey}" Classes="body" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Classes="pk-input" Text="{Binding AiApiKey, Mode=TwoWay}" PasswordChar="•" FontSize="12" Watermark="粘贴 API Key..." />
                                        </Grid>

                                        <Border Classes="divider-h" />

                                        <Grid ColumnDefinitions="120,*">
                                            <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Ai_Model}" Classes="body" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Classes="pk-input" Text="{Binding AiModel, Mode=TwoWay}" FontSize="12" />
                                        </Grid>

                                        <Border Classes="divider-h" />

                                        <Grid ColumnDefinitions="120,*">
                                            <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Ai_Format}" Classes="body" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding AiApiFormats}" SelectedItem="{Binding AiApiFormat, Mode=TwoWay}" FontSize="12" />
                                        </Grid>

                                        <Border Classes="divider-h" />

                                        <Grid ColumnDefinitions="120,*" Margin="0,4,0,0">
                                            <Border Grid.Column="0" />
                                            <Button Grid.Column="1"
                                                    Command="{Binding SaveAiConfigCommand}"
                                                    Classes="accent"
                                                    Padding="16,6"
                                                    FontSize="12"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{loc:Loc Settings_Ai_Save}" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Tab 10: 关于与在线更新 -->
                            <StackPanel Spacing="16" IsVisible="{Binding IsTabAbout}">
                                <TextBlock Text="关于 Pankin" Classes="h1" />

                                <Border Classes="module-card">
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Border Width="40" Height="40" CornerRadius="10">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                        <GradientStop Offset="0" Color="#9B8CFF" />
                                                        <GradientStop Offset="1" Color="#5B6CFF" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="P" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Pankin for Ubuntu 24.04 (Linux 原生效率工具)" Classes="body" FontWeight="SemiBold" />
                                                <TextBlock Text="基于 Avalonia UI + SharpHook + SQLite 重构" Classes="caption" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Text="Pankin 将 Windows WPF 生产力利器原生移植到 Linux 环境，整合应用启动、剪贴板历史、全局鼠标手势、划词悬浮超级面板与流式大模型 AI。"
                                                   Classes="secondary"
                                                   TextWrapping="Wrap"
                                                   LineHeight="19"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- 在线更新卡片 (UpdateViewModel) -->
                                <Border Classes="module-card">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="软件版本检查" Classes="body" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding UpdateSettings.StatusText}" Classes="caption" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Button Content="检查更新"
                                                        Command="{Binding UpdateSettings.CheckUpdateCommand}"
                                                        IsEnabled="{Binding !UpdateSettings.IsChecking}"
                                                        Classes="accent"
                                                        Padding="14,6"
                                                        FontSize="12" />
                                                <Button Content="打开发布页面"
                                                        Command="{Binding UpdateSettings.OpenReleasePageCommand}"
                                                        IsVisible="{Binding UpdateSettings.IsAvailable}"
                                                        Classes="secondary-btn"
                                                        Padding="14,6"
                                                        FontSize="12" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- 下载进度条 -->
                                        <ProgressBar IsVisible="{Binding UpdateSettings.IsDownloading}"
                                                     Value="{Binding UpdateSettings.DownloadProgress}"
                                                     Minimum="0" Maximum="1"
                                                     Height="3"
                                                     Background="{DynamicResource Pk.SurfaceInput}"
                                                     Foreground="{DynamicResource Pk.Accent}" />

                                        <!-- 错误提示 -->
                                        <TextBlock IsVisible="{Binding UpdateSettings.HasFailed}"
                                                   Text="{Binding UpdateSettings.Error}"
                                                   Classes="caption"
                                                   Foreground="{DynamicResource Pk.Danger}"
                                                   TextWrapping="Wrap" />

                                        <!-- 新版更新日志 -->
                                        <Border IsVisible="{Binding UpdateSettings.HasReleaseNotes}"
                                                Background="{DynamicResource Pk.SurfaceInput}"
                                                BorderBrush="{DynamicResource Pk.Stroke}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource Pk.Radius.Control}"
                                                Padding="12"
                                                Margin="0,4,0,0">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="更新说明 (Release Notes):" Classes="body" FontWeight="SemiBold" Foreground="{DynamicResource Pk.AccentText}" />
                                                <TextBlock Text="{Binding UpdateSettings.ReleaseNotes}" Classes="caption" TextWrapping="Wrap" MaxHeight="160" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Panel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Panel>
    </Border>
</Window>